# Demo requests from the website are sent by app/api/leads (lead.js) through Microsoft Graph:
# a notification to BOOK_DEMO_TO, then a "request received" acknowledgement to the customer.
# Copy this file to .env.local for local runs, or set the same variables on the host
# (Vercel: Preview and Production). All five are required; an unset one makes the form show its error (503).
# Real values never go in the repo, chat or mail.

# Microsoft tenant used for sign-in
MAIL_GRAPH_TENANT_ID=
# the website's own Entra app (not the Cygnus one)
MAIL_GRAPH_CLIENT_ID=
# that app's secret: on Vercel, mark it sensitive
MAIL_GRAPH_CLIENT_SECRET=
# mailbox the mail is sent from; its display name is the From name
MAIL_GRAPH_SENDER=donotreply@example.com
# receives the notification and customer replies; comma-separated for several
BOOK_DEMO_TO=bookdemo@example.com
