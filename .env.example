# Demo requests from the website are emailed by app/api/leads/route.ts over SMTP.
# Copy this file to .env.local for local runs, or set the same variables on the host (Vercel, Netlify, a VM, ...).

# SMTP server of the mailbox that sends the emails
#   Google Workspace: smtp.gmail.com, port 587, user = the mailbox, pass = an app password (Google account > Security > App passwords)
#   Microsoft 365:    smtp.office365.com, port 587, user = the mailbox, pass = its password (SMTP AUTH must be enabled for it)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true only for port 465
SMTP_SECURE=false
SMTP_USER=info@infrax.ai
SMTP_PASS=

# where requests go (default info@infrax.ai) and the sender address (default SMTP_USER)
LEAD_TO=info@infrax.ai
LEAD_FROM=info@infrax.ai
